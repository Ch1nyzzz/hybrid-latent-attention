# Publish research code only; data, runs, weights, logs and synced sources stay local.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/RESEARCH_OBJECTIVE.md
!/THIRD_PARTY_NOTICES.md
!/LICENSES/
!/hla/
!/results/

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.env
.env.*
*.pem
*.key
*.pt
*.pth
*.safetensors
*.bin
*.log
*.jsonl
.DS_Store

# committed result summaries may be jsonl
!/results/**/*.jsonl
